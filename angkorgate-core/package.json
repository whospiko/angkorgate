{
  "name": "angkorgate-core",
  "version": "0.0.1",
  "description": "Open-source Identity and Access Management (IAM).",
  "author": "Heng Kakada",
  "private": true,
  "license": "LICENSED",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "./node_modules/.bin/cross-env DB_TYPE=sqlite CREATE_DEV_ADMIN=true nest start --watch",
    "start:dev:memory": "./node_modules/.bin/cross-env DB_TYPE=sqlite DB_SQLITE_DATABASE=:memory: CREATE_DEV_ADMIN=true nest start --watch",
    "start:dev:postgres": "./node_modules/.bin/cross-env DB_TYPE=postgres CREATE_DEV_ADMIN=false nest start --watch",
    "start:dev-postgres": "./node_modules/.bin/cross-env DB_TYPE=postgres CREATE_DEV_ADMIN=false nest start --watch",
    "start:debug": "./node_modules/.bin/cross-env DB_TYPE=sqlite nest start --debug --watch",
    "start:prod": "./node_modules/.bin/cross-env DB_TYPE=postgres node dist/main",
    "lint": "./node_modules/.bin/oxlint --type-aware src/ test/",
    "typeorm": "./node_modules/.bin/typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "./node_modules/.bin/cross-env DB_TYPE=postgres node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand",
    "test:e2e:watch": "./node_modules/.bin/cross-env DB_TYPE=postgres node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --watch --runInBand",
    "test:all": "npm run test && npm run test:e2e",
    "smoke": "./node_modules/.bin/cross-env DB_TYPE=postgres ./node_modules/.bin/ts-node -r tsconfig-paths/register test/smoke-test.ts",
    "smoke:postgres": "./node_modules/.bin/cross-env DB_TYPE=postgres ./node_modules/.bin/ts-node -r tsconfig-paths/register test/smoke-test.ts",
    "smoke:sqlite": "./node_modules/.bin/cross-env DB_TYPE=sqlite DB_SQLITE_DATABASE=:memory: ./node_modules/.bin/ts-node -r tsconfig-paths/register test/smoke-test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/mapped-types": "^12.0.1",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@simplewebauthn/server": "^14.1.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.11.1",
    "jose": "^6.2.18",
    "nodemailer": "^10.4.0",
    "oidc-provider": "^9.15.1",
    "otplib": "^13.6.0",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.5.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/oidc-provider": "^9.13.1",
    "@types/passport-apple": "^2.0.3",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "cross-spawn": "^7.0.5"
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "@parcel/watcher@2.6.0": true,
    "better-sqlite3": true
  }
}
