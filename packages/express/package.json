{
  "name": "@angkorgate/express",
  "version": "0.1.0",
  "description": "Drop-in Express.js middleware for AngkorGate SSO authentication and RBAC role/permission guards.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "./node_modules/.bin/tsup",
    "typecheck": "./node_modules/.bin/tsc --noEmit",
    "test": "./node_modules/.bin/tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@angkorgate/sdk": "file:../sdk"
  },
  "peerDependencies": {
    "express": ">=4.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^20.0.0",
    "express": "^5.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
